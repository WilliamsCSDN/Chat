{
  "mcpServers": {
    "my-coffee": {
      "type": "streamablehttp",
      "url": "https://gwmcp.lkcoffee.com/order/user/mcp",
      "headers": {
        "Authorization": "Bearer "
      },
      "description": "咖啡下单、订单查询、门店信息等业务能力（可选：MCP 服务器未在 initialize.instructions 中提供说明时的本地兜底描述）"
    },

    "tyc-mcp": {
      "url": "https://mcp.tianyancha.com/v1",
      "headers": {
        "Authorization": ""
      }
    },

    "RollingGo-Hotel": {
      "url": "https://mcp.rollinggo.cn/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer "
      }
    },
    "RollingGo-Flight": {
      "url": "https://mcp.rollinggo.cn/mcp/flight",
      "type": "http",
      "headers": {
        "Authorization": "Bearer "
      }
    }
  }
}
